{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -w shared && npm run build -w web",
  "outputDirectory": "web/dist",
  "installCommand": "npm install --include=dev",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/auth/(.*)", "destination": "/api/index" },
    { "source": "/privacy-policy.html", "destination": "/privacy.html" },
    { "source": "/terms-of-service.html", "destination": "/terms.html" }
  ]
}
