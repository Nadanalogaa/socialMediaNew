# Variables for the Portainer stack. Paste into Stacks → socialboost →
# Environment variables (or "Load variables from .env file").
#
# Secrets live only in Portainer, never in git.

# The public address, with https and no trailing slash.
APP_URL=https://social.nadanaloga.com

# Database in this stack. Any long random string.
POSTGRES_PASSWORD=

# Leave DATABASE_URL and REDIS_URL unset to use the database and Redis in
# this stack. Set DATABASE_URL only to keep using Neon.
# DATABASE_URL=
# REDIS_URL=

# 32+ characters; 64 hex characters. Keep the SAME values as before, or every
# saved login and every connected Facebook/Instagram account stops working.
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Meta app "SocialMedia".
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
VITE_META_APP_ID=
VITE_META_CONFIG_ID=615765401252483
VITE_META_INSTAGRAM_ENABLED=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional.
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LOG_LEVEL=info
